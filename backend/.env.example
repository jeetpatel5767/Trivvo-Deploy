PORT=3002
DATABASE_URL=postgresql://user:password@localhost:5432/trivvo
CHAIN_ID=4801
CHAIN_RPC_URL=https://worldchain-sepolia.g.alchemy.com/public
EXPLORER_URL=https://sepolia.worldscan.org
PRIVATE_KEY=your_private_key_here
HUNT_ESCROW_ADDRESS=your_contract_address_here
USDC_TOKEN_ADDRESS=0xF480b41Db3C35C6bf770028E003b007A9a142e98

# A1: HMAC secret for wallet sessions (any long random string)
SESSION_SECRET=change_me

# 0G trust mode: must match the API key default in the PC dashboard (standard | verified | private)
ZG_TRUST_MODE=private

# One World ID action per hunt (World allows one verification per person per action).
# Developer Portal -> API Keys. Without it the old shared actions are used.
WORLD_PORTAL_API_KEY=

# World ID (Developer Portal app). RP signing key stays on the server.
WORLD_APP_ID=app_...
RP_ID=rp_...
RP_SIGNING_KEY=

# 0G Private Computer (OpenAI-compatible Router)
ZG_API_KEY=
ZG_MODEL=0gm-1.0-35b-a3b

# Hedera testnet (JS SDK only)
HEDERA_ACCOUNT_ID=0.0.xxxxx
HEDERA_PRIVATE_KEY=
HEDERA_KEY_TYPE=ECDSA
HEDERA_TOPIC_ID=
HEDERA_TOKEN_ID=
